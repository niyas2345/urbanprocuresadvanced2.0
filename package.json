{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "check:repository": "node scripts/check-repository.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "test:continuation": "tsx scripts/test-continuation.mjs",
    "dev:legacy": "tsx server.ts",
    "worker:dev": "node scripts/check-repository.mjs && node scripts/check-isolation.mjs && wrangler dev --local --config \"urbanprocures advanced/workers/wrangler.toml\"",
    "db:migrate:local": "node scripts/check-repository.mjs && node scripts/check-isolation.mjs && wrangler d1 migrations apply DB --local --config \"urbanprocures advanced/workers/wrangler.toml\"",
    "test:database": "python3 scripts/test-database.py",
    "test:worker-auth": "node scripts/test-worker-auth.mjs",
    "test:terms": "node scripts/test-terms.mjs",
    "test:terms-ui": "node scripts/test-terms-ui.mjs",
    "test:operations": "node scripts/test-operations.mjs",
    "test:wrangler-migrations": "node scripts/test-wrangler-migrations.mjs",
    "test:zoho-oauth": "tsx scripts/test-zoho-oauth.ts",
    "test:zoho-runtime": "node scripts/test-zoho-runtime.mjs",
    "test:staging": "node scripts/test-deployed-staging.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "4.147.0"
  }
}
